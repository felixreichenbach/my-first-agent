# Copy to .env and fill in. .env is git-ignored.

# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Agent behaviour (optional) --------------------------------------------
MODEL=claude-haiku-4-5-20251001
MAX_ITERATIONS=10

# --- Telemetry (optional) ---------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty/commented to disable telemetry.
# Standard OpenTelemetry variables only; nothing here is Grafana-specific.

# Option A: Grafana Cloud
#   Find the endpoint under: Grafana Cloud portal > your stack > OpenTelemetry > Configure.
#   Generate a token there, then base64-encode "<instance-id>:<token>":
#     echo -n "123456:glc_xxx" | base64
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-and-token>

# Option B: Collector / Alloy / Grafana stack running on your host.
#   "localhost" inside a container is the container itself, so use host.docker.internal.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Option C: print spans to the terminal instead (no backend needed).
# OTEL_TRACES_EXPORTER=console

OTEL_SERVICE_NAME=my-first-agent
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# Record prompts, tool inputs and tool outputs on spans. May contain secrets; off by default.
OTEL_CAPTURE_CONTENT=false

# --- Web UI (optional) ------------------------------------------------------
# Host port for the chat UI (bound to 127.0.0.1 only): http://localhost:8080
# UI_PORT=8080
