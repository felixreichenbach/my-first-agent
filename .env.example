# Copy to .env and fill in. .env is git-ignored.

# --- Model provider (required) ----------------------------------------------
# The default provider is Anthropic. To use another one: add its LangChain package to
# agent/requirements.txt (e.g. langchain-openai), set MODEL=<provider>:<model>
# (e.g. openai:gpt-5.5) and that provider's key (e.g. OPENAI_API_KEY). Only Anthropic is tested.
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Agent behaviour (optional) --------------------------------------------
# "claude-..." or "anthropic:claude-..." for Anthropic; "<provider>:<model>" for anything else.
MODEL=claude-haiku-4-5-20251001
MAX_ITERATIONS=10

# --- Web UI (optional) ------------------------------------------------------
# Host port for the chat UI (bound to 127.0.0.1 only): http://localhost:8080
# UI_PORT=8080

# --- Grafana Agent Observability (optional) --------------------------------
# Leave this block commented out to run without any telemetry.
#
# To enable: in Grafana open Observability > Agent > Agents > Add more agents > "Agents you
# build", copy the environment variables it shows, and paste them over the lines below
# (same names, same order), then uncomment. The values are used exactly as the UI prints
# them, including the quotes and the space in OTEL_EXPORTER_OTLP_HEADERS.
#
# AGENTO11Y_AUTH_TOKEN needs the scopes sigil:write, metrics:write, traces:write and logs:write
# (use "Add scope" to find "sigil"). Never commit it; .env is git-ignored.
#
# AGENTO11Y_ENDPOINT=https://agento11y-prod-eu-central-0.grafana.net
# AGENTO11Y_PROTOCOL=http
# AGENTO11Y_AUTH_MODE=basic
# AGENTO11Y_AUTH_TENANT_ID=<instance id>
# AGENTO11Y_AUTH_TOKEN=glc_<token>
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS='Authorization=Basic <base64 of "<instance id>:<token>">'

# Optional: version reported for this agent in Grafana (default 0.1.0).
# AGENT_VERSION=0.1.0
