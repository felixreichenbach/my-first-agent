# Copy to .env and fill in. .env is git-ignored.

# --- Model (required) -------------------------------------------------------
# Anthropic is the default. For another provider (only Anthropic is tested): add its LangChain
# package to agent/requirements.txt, set MODEL=<provider>:<model> (e.g. openai:<model>) and that
# provider's own key (OPENAI_API_KEY, GOOGLE_API_KEY, ...). Local providers like ollama need no key.
ANTHROPIC_API_KEY=sk-ant-replace-me
# OPENAI_API_KEY=sk-replace-me
MODEL=claude-haiku-4-5-20251001
MAX_ITERATIONS=10

# --- Web UI (optional) ------------------------------------------------------
# Host port for the chat UI, bound to 127.0.0.1.
# UI_PORT=8080

# --- Grafana Agent Observability (optional) ---------------------------------
# Only used once you instrument the app. In Grafana open Observability > Agent > Agents >
# Add more agents > "Agents you build" and paste the variables it shows over these lines, as printed.
# The token needs the scopes sigil, metrics, traces and logs (write). Never commit it.
# AGENTO11Y_ENDPOINT=https://agento11y-prod-eu-central-0.grafana.net
# AGENTO11Y_PROTOCOL=http
# AGENTO11Y_AUTH_MODE=basic
# AGENTO11Y_AUTH_TENANT_ID=<instance id>
# AGENTO11Y_AUTH_TOKEN=glc_<token>
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS='Authorization=Basic <base64 of "<instance id>:<token>">'
# AGENT_VERSION=0.1.0
